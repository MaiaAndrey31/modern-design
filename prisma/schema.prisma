// Modern — CMS / engine schema.
// Database: PostgreSQL (Supabase). See README > "CMS / Admin" for the
// DATABASE_URL (pooled, port 6543) vs DIRECT_URL (direct, port 5432) setup.
//
// Conventions (see docs/CMS.md once written):
//  - Singletons: `id String @id @default("singleton")`. Always read with
//    findUnique({ where: { id: SINGLETON_ID } }) and write with upsert().
//    The baseline migration adds CHECK ("id" = 'singleton') to each one.
//  - Localised copy: `xPt` is required, `xEn` optional — an empty EN value
//    falls back to PT (src/lib/i18n/locale.ts). Lists: `xPt String[]` /
//    `xEn String[]`, empty EN list falls back to PT.
//  - Editorial text has NO Prisma default: the single source of default copy
//    is SYSTEM_DEFAULTS (src/lib/content/defaults.ts), used by both the seed
//    and the content loaders' fallbacks. Prisma defaults are only for flags,
//    numbers and technical values.
//  - Prisma enums only for closed sets whose meaning lives in code. Sets that
//    grow by adding a registry entry (fonts, social platforms, media
//    categories, section keys, Story visuals, label positions) are Strings
//    validated by the application registries — adding one needs no migration.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  EDITOR
}

enum ContentStatus {
  DRAFT
  PUBLISHED
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum ReleaseType {
  SINGLE
  EP
  ALBUM
  REMIX
}

enum Orientation {
  PORTRAIT
  LANDSCAPE
  SQUARE
}

/// Experience section's fixed 4-slot editorial grid. Maps to a statically
/// written Tailwind class map in code — never store class strings in the DB
/// (Tailwind v4 scans source files at build time; a class read from Postgres
/// produces no generated CSS). See src/sections/Experience.tsx.
enum FrameLayout {
  WIDE
  TALL
}

enum ShowStatus {
  SCHEDULED
  CANCELLED
  POSTPONED
  RESCHEDULED
}

enum BookingRequestStatus {
  NEW
  READ
  REPLIED
  ARCHIVED
}

enum Locale {
  pt
  en
}

enum NavigationLocation {
  HEADER
  FOOTER_PRIMARY
  FOOTER_SECONDARY
  FOOTER_LEGAL
}

/// SECTION: target = a section key (SECTION_REGISTRY) · ROUTE: target = "/path"
/// · EXTERNAL: target = "https://…". Validated in src/lib/validations/admin/navigation.ts.
enum NavigationItemType {
  SECTION
  ROUTE
  EXTERNAL
}

/// How a Place takes part in a Story chapter's map choreography.
/// CAMERA rows (ordered by sortOrder) are the camera frames played in sequence.
enum StoryPlaceRole {
  CAMERA
  LABEL
  PULSE
  ROUTE_FROM
  ROUTE_TO
}

// ---------------------------------------------------------------------------
// Auth.js v5 (credentials provider ⇒ JWT sessions; Session/Account tables
// stay in place so an OAuth provider can be added later without a migration)
// ---------------------------------------------------------------------------

model User {
  id                  String    @id @default(cuid())
  name                String?
  email               String    @unique
  emailVerified       DateTime?
  image               String?
  passwordHash        String?
  role                Role      @default(EDITOR)
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  uploadedMedia Media[]    @relation("MediaUploader")
  auditLogs     AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Media — the hub. Every content model below points at Media by FK with
// onDelete: Restrict, and Media carries the matching named back-relation, so
// "is this file in use?" is one query (src/lib/content/media.ts) backed by a
// real DB constraint. That query's label map is typed against
// Prisma.MediaCountOutputType, so adding a media FK here without a label is
// a TypeScript error — the usage check can't silently under-report.
// ---------------------------------------------------------------------------

model Media {
  id               String    @id @default(cuid())
  bucket           String    @default("uploads")
  /// Physical storage key. Its first segment is the category at upload time
  /// and never changes afterwards — `category` is logical metadata only.
  path             String    @unique
  url              String
  kind             MediaKind @default(IMAGE)
  mimeType         String
  sizeBytes        Int
  width            Int?
  height           Int?
  durationSec      Int?
  blurDataUrl      String?   @db.Text
  alt              String?
  title            String?
  originalFilename String?
  /// MEDIA_CATEGORIES (src/lib/media/categories.ts).
  category         String    @default("general")
  uploadedById     String?
  uploadedBy       User?     @relation("MediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  brandPrimaryLogos   BrandSettings[]    @relation("BrandPrimaryLogo")
  brandSecondaryLogos BrandSettings[]    @relation("BrandSecondaryLogo")
  brandLightLogos     BrandSettings[]    @relation("BrandLightLogo")
  brandDarkLogos      BrandSettings[]    @relation("BrandDarkLogo")
  brandIcons          BrandSettings[]    @relation("BrandIcon")
  brandFavicons       BrandSettings[]    @relation("BrandFavicon")
  seoOgImages         SeoSettings[]      @relation("SeoOgImage")
  heroBackgrounds     HeroSection[]      @relation("HeroBackground")
  heroVideos          HeroSection[]      @relation("HeroVideo")
  heroPosters         HeroSection[]      @relation("HeroPoster")
  statementBgs        StatementSection[] @relation("StatementBackground")
  narrativeBgs        NarrativeSection[] @relation("NarrativeBackground")
  pressKitOneSheets   PressKitSection[]  @relation("PressKitOneSheet")
  pressKitPhotoPacks  PressKitSection[]  @relation("PressKitPhotos")
  pressKitLogoPacks   PressKitSection[]  @relation("PressKitLogos")
  storyChapterImages  StoryChapter[]     @relation("StoryChapterImage")
  worldStageImages    WorldStage[]       @relation("StageImage")
  worldStageVideos    WorldStage[]       @relation("StageVideo")
  experienceFrames    ExperienceFrame[]  @relation("ExperienceFrameMedia")
  releaseCovers       Release[]          @relation("ReleaseCover")
  galleryItems        GalleryItem[]      @relation("GalleryMedia")
  pressLogos          PressItem[]        @relation("PressLogo")
  showImages          Show[]             @relation("ShowImage")

  @@index([category, kind])
  @@index([kind, createdAt])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Global settings (singletons, id = "singleton")
// ---------------------------------------------------------------------------

/// Technical site configuration — no brand identity, no editorial copy.
model SiteSettings {
  id             String   @id @default("singleton")
  /// Canonical public URL. Falls back to NEXT_PUBLIC_SITE_URL →
  /// VERCEL_PROJECT_PRODUCTION_URL → http://localhost:3000 (src/lib/siteUrl.ts).
  siteUrl        String?
  /// Language rendered on the server and used when a visitor has no saved preference.
  defaultLocale  Locale   @default(pt)
  contactEmail   String?
  contactPhone   String?
  whatsappNumber String?
  updatedAt      DateTime @updatedAt
}

/// Universal brand identity — valid for any Modern install (artist, company,
/// product). Subject-specific data (roles, bio, origin…) lives in Profile.
model BrandSettings {
  id              String   @id @default("singleton")
  brandName       String
  shortName       String
  /// 1–3 characters, used where a mark must fit a tiny space (e.g. record label).
  monogram        String
  taglinePt       String
  taglineEn       String?
  descriptionPt   String   @db.Text
  descriptionEn   String?  @db.Text
  primaryLogoId   String?
  primaryLogo     Media?   @relation("BrandPrimaryLogo", fields: [primaryLogoId], references: [id], onDelete: Restrict)
  secondaryLogoId String?
  secondaryLogo   Media?   @relation("BrandSecondaryLogo", fields: [secondaryLogoId], references: [id], onDelete: Restrict)
  lightLogoId     String?
  lightLogo       Media?   @relation("BrandLightLogo", fields: [lightLogoId], references: [id], onDelete: Restrict)
  darkLogoId      String?
  darkLogo        Media?   @relation("BrandDarkLogo", fields: [darkLogoId], references: [id], onDelete: Restrict)
  /// Square mark (apple-touch-icon, compact UI).
  iconId          String?
  icon            Media?   @relation("BrandIcon", fields: [iconId], references: [id], onDelete: Restrict)
  faviconId       String?
  favicon         Media?   @relation("BrandFavicon", fields: [faviconId], references: [id], onDelete: Restrict)
  updatedAt       DateTime @updatedAt
}

/// Colour + shape tokens. Only base colours are stored; tints/shades are
/// derived in CSS with color-mix(). Hex "#RRGGBB" validated by
/// src/lib/validations/admin/theme.ts.
model ThemeSettings {
  id              String   @id @default("singleton")
  background      String
  surface         String
  foreground      String
  textMuted       String
  border          String
  primary         String
  primaryContrast String
  secondary       String
  accent          String
  success         String
  danger          String
  buttonRadius    Int      @default(999)
  cardRadius      Int      @default(16)
  updatedAt       DateTime @updatedAt
}

/// Font roles. Ids are FontRegistry keys (src/lib/fonts/registry.ts) — plain
/// Strings so adding a font never needs a migration; an unknown id falls back
/// to the role's default font at render time.
model TypographySettings {
  id              String   @id @default("singleton")
  displayFontId   String
  headingFontId   String
  bodyFontId      String
  displayWeight   Int      @default(700)
  headingWeight   Int      @default(700)
  bodyWeight      Int      @default(400)
  /// Letter-spacing in em.
  displayTracking Float    @default(0)
  headingTracking Float    @default(0)
  /// Multiplier applied to the fluid type scale (0.85–1.15).
  typeScale       Float    @default(1)
  updatedAt       DateTime @updatedAt
}

model HeaderSettings {
  id                 String             @id @default("singleton")
  /// LOGO_VARIANTS: primary | secondary | light | dark (from BrandSettings).
  logoVariant        String             @default("primary")
  showLanguageSwitch Boolean            @default(true)
  showSocials        Boolean            @default(false)
  showCta            Boolean            @default(true)
  ctaLabelPt         String
  ctaLabelEn         String?
  ctaType            NavigationItemType @default(SECTION)
  ctaTarget          String
  updatedAt          DateTime           @updatedAt
}

model FooterSettings {
  id               String             @id @default("singleton")
  logoVariant      String             @default("primary")
  showWordmark     Boolean            @default(true)
  descriptionPt    String?            @db.Text
  descriptionEn    String?            @db.Text
  /// Supports the tokens {year} and {brand}.
  copyrightPt      String
  copyrightEn      String?
  backToTopLabelPt String
  backToTopLabelEn String?
  showBookingCta   Boolean            @default(true)
  bookingLabelPt   String
  bookingLabelEn   String?
  bookingType      NavigationItemType @default(SECTION)
  bookingTarget    String
  showSocials      Boolean            @default(true)
  showContact      Boolean            @default(false)
  updatedAt        DateTime           @updatedAt
}

model SeoSettings {
  id                String   @id @default("singleton")
  metaTitlePt       String
  metaTitleEn       String?
  metaDescriptionPt String   @db.Text
  metaDescriptionEn String?  @db.Text
  ogImageId         String?
  ogImage           Media?   @relation("SeoOgImage", fields: [ogImageId], references: [id], onDelete: Restrict)
  twitterHandle     String?
  robotsIndex       Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model NavigationItem {
  id           String             @id @default(cuid())
  location     NavigationLocation @default(HEADER)
  type         NavigationItemType @default(SECTION)
  labelPt      String
  labelEn      String?
  target       String
  openInNewTab Boolean            @default(false)
  enabled      Boolean            @default(true)
  sortOrder    Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([location, enabled, sortOrder])
}

model SocialLink {
  id           String   @id @default(cuid())
  /// SOCIAL_PLATFORMS key (src/lib/social/registry.ts); unknown → generic link icon.
  platform     String
  label        String
  url          String
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  showInHeader Boolean  @default(false)
  showInFooter Boolean  @default(true)
  showInMusic  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([enabled, sortOrder])
}

// ---------------------------------------------------------------------------
// Template content — the subject presented by the site (artist, person,
// company). Kept out of BrandSettings so the brand stays universal.
// ---------------------------------------------------------------------------

model Profile {
  id            String   @id @default("singleton")
  /// e.g. ["DJ", "Produtor"] — shown as the Hero/Footer eyebrow.
  rolesPt       String[]
  rolesEn       String[]
  bioPt         String   @db.Text
  bioEn         String?  @db.Text
  /// e.g. "Sul de Minas — Brasil".
  originLabelPt String?
  originLabelEn String?
  foundedYear   Int?
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Sections. `Section` holds what every section shares (visibility, order,
// generic copy); the SECTION_REGISTRY (src/lib/sections/registry.ts) defines
// which keys exist, which generic fields each one uses and how the admin
// labels them. Models below exist only for sections with their own structure.
// ---------------------------------------------------------------------------

model Section {
  /// SECTION_REGISTRY key, e.g. "hero", "story", "gallery".
  key           String              @id
  enabled       Boolean             @default(true)
  sortOrder     Int                 @default(0)
  eyebrowPt     String?
  eyebrowEn     String?
  titlePt       String?
  titleEn       String?
  subtitlePt    String?
  subtitleEn    String?
  descriptionPt String?             @db.Text
  descriptionEn String?             @db.Text
  emptyTextPt   String?             @db.Text
  emptyTextEn   String?             @db.Text
  ctaLabelPt    String?
  ctaLabelEn    String?
  ctaType       NavigationItemType?
  ctaTarget     String?
  updatedAt     DateTime            @updatedAt

  @@index([enabled, sortOrder])
}

model HeroSection {
  id                  String             @id @default("singleton")
  /// Big headline, one entry per line. Empty → BrandSettings.brandName.
  headlineLinesPt     String[]
  headlineLinesEn     String[]
  backgroundImageId   String?
  backgroundImage     Media?             @relation("HeroBackground", fields: [backgroundImageId], references: [id], onDelete: Restrict)
  videoId             String?
  video               Media?             @relation("HeroVideo", fields: [videoId], references: [id], onDelete: Restrict)
  posterImageId       String?
  posterImage         Media?             @relation("HeroPoster", fields: [posterImageId], references: [id], onDelete: Restrict)
  /// Background video from YouTube (takes precedence over `video` when set).
  youtubeUrl          String?
  enableWebgl         Boolean            @default(true)
  /// Label before Profile.foundedYear, e.g. "Desde" / "Est.".
  foundedLabelPt      String?
  foundedLabelEn      String?
  primaryCtaLabelPt   String?
  primaryCtaLabelEn   String?
  primaryCtaType      NavigationItemType @default(SECTION)
  primaryCtaTarget    String?
  secondaryCtaLabelPt String?
  secondaryCtaLabelEn String?
  secondaryCtaType    NavigationItemType @default(SECTION)
  secondaryCtaTarget  String?
  updatedAt           DateTime           @updatedAt
}

model StatementSection {
  id                String   @id @default("singleton")
  linesPt           String[]
  linesEn           String[]
  /// Index of the line set in the accent colour (null = none).
  accentIndex       Int?
  backgroundImageId String?
  backgroundImage   Media?   @relation("StatementBackground", fields: [backgroundImageId], references: [id], onDelete: Restrict)
  showGlobe         Boolean  @default(true)
  updatedAt         DateTime @updatedAt
}

model NarrativeSection {
  id                String   @id @default("singleton")
  linesPt           String[]
  linesEn           String[]
  /// Word revealed at the end. Empty → BrandSettings.brandName.
  finalWordPt       String?
  finalWordEn       String?
  /// Scroll length per line, in vh (validated 70–130).
  vhPerLine         Int      @default(95)
  backgroundImageId String?
  backgroundImage   Media?   @relation("NarrativeBackground", fields: [backgroundImageId], references: [id], onDelete: Restrict)
  updatedAt         DateTime @updatedAt
}

/// Story interludes. The section heading comes from Section("story").
model StorySection {
  id              String   @id @default("singleton")
  introQuestionPt String?
  introQuestionEn String?
  thesisLinesPt   String[]
  thesisLinesEn   String[]
  outroLinesPt    String[]
  outroLinesEn    String[]
  updatedAt       DateTime @updatedAt
}

model PressKitSection {
  id              String   @id @default("singleton")
  /// Empty → Profile.bio.
  bioOverridePt   String?  @db.Text
  bioOverrideEn   String?  @db.Text
  oneSheetId      String?
  oneSheet        Media?   @relation("PressKitOneSheet", fields: [oneSheetId], references: [id], onDelete: Restrict)
  photoPackId     String?
  photoPack       Media?   @relation("PressKitPhotos", fields: [photoPackId], references: [id], onDelete: Restrict)
  logoPackId      String?
  logoPack        Media?   @relation("PressKitLogos", fields: [logoPackId], references: [id], onDelete: Restrict)
  downloadsNotePt String?
  downloadsNoteEn String?
  updatedAt       DateTime @updatedAt
}

/// Booking form copy. Heading/intro come from Section("booking").
model BookingSection {
  id               String   @id @default("singleton")
  successTitlePt   String
  successTitleEn   String?
  successMessagePt String
  successMessageEn String?
  submitLabelPt    String
  submitLabelEn    String?
  pausedMessagePt  String
  pausedMessageEn  String?
  /// { [field in BOOKING_FORM_FIELDS]: { pt: string; en?: string } }.
  /// Fixed shape coupled to the form schema in code; always parsed with
  /// bookingFieldLabelsSchema (src/lib/validations/admin/booking.ts) — never
  /// trusted raw, never edited as free JSON in the admin.
  fieldLabels      Json
  notifyEmail      String?
  isFormEnabled    Boolean  @default(true)
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Collections — sortable, publishable. Reordering rewrites the whole (short)
// list's sortOrder in one transaction; no float-gap arithmetic.
// ---------------------------------------------------------------------------

/// One Story chapter (was: TimelineEvent + src/i18n/story.ts CHAPTERS).
model StoryChapter {
  id              String              @id @default(cuid())
  /// Big period label, e.g. "1995–2000" / "Hoje".
  periodLabelPt   String
  periodLabelEn   String?
  /// Short label on the progress axis (null = dot without label).
  axisLabel       String?
  /// Giant background type. Empty → first 4 chars of periodLabel.
  ghostLabelPt    String?
  ghostLabelEn    String?
  conceptPt       String
  conceptEn       String?
  titlePt         String
  titleEn         String?
  placeLabelPt    String?
  placeLabelEn    String?
  textPt          String              @db.Text
  textEn          String?             @db.Text
  pullQuotePt     String?
  pullQuoteEn     String?
  /// STORY_VISUAL_TYPES (src/lib/story/registry.ts).
  visualType      String              @default("map")
  imageId         String?
  image           Media?              @relation("StoryChapterImage", fields: [imageId], references: [id], onDelete: Restrict)
  /// false = archive-era chapter: never shows a photograph.
  allowPhoto      Boolean             @default(true)
  /// Expanding rings around the origin ("many cities" without naming any).
  showRings       Boolean             @default(false)
  /// The "break" interlude is played right before this chapter (at most one).
  startsGlobalAct Boolean             @default(false)
  /// Relative scroll length (validated 0.6–1.6).
  scrollWeight    Float               @default(1)
  sortOrder       Int                 @default(0)
  status          ContentStatus       @default(DRAFT)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  places          StoryChapterPlace[]

  @@index([status, sortOrder])
}

/// A geographic point used by the Story map and the origin globe.
model Place {
  id             String              @id @default(cuid())
  namePt         String
  nameEn         String?
  /// −90…90 / −180…180, validated in src/lib/validations/admin/story.ts.
  latitude       Float
  longitude      Float
  /// LABEL_POSITIONS: right | left | above | below.
  labelPosition  String              @default("right")
  /// When set, the place can frame the map camera (width in degrees, validated range).
  cameraWidthDeg Float?
  /// The journey's origin (globe routes start here). At most one.
  isOrigin       Boolean             @default(false)
  showOnGlobe    Boolean             @default(false)
  globeOrder     Int?
  sortOrder      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  chapterLinks   StoryChapterPlace[]

  @@index([showOnGlobe, globeOrder])
}

model StoryChapterPlace {
  id        String         @id @default(cuid())
  chapterId String
  chapter   StoryChapter   @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  placeId   String
  place     Place          @relation(fields: [placeId], references: [id], onDelete: Restrict)
  role      StoryPlaceRole
  sortOrder Int            @default(0)

  @@unique([chapterId, placeId, role])
  @@index([placeId])
}

model WorldStage {
  id            String        @id @default(cuid())
  yearLabel     String
  titlePt       String
  titleEn       String?
  locationPt    String
  locationEn    String?
  descriptionPt String        @db.Text
  descriptionEn String?       @db.Text
  imageId       String?
  image         Media?        @relation("StageImage", fields: [imageId], references: [id], onDelete: Restrict)
  videoId       String?
  video         Media?        @relation("StageVideo", fields: [videoId], references: [id], onDelete: Restrict)
  showInNumbers Boolean       @default(true)
  sortOrder     Int           @default(0)
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, sortOrder])
}

model ExperienceFrame {
  id        String        @id @default(cuid())
  slot      Int           @unique
  layout    FrameLayout   @default(WIDE)
  offsetPx  Int           @default(0)
  mediaId   String?
  media     Media?        @relation("ExperienceFrameMedia", fields: [mediaId], references: [id], onDelete: Restrict)
  altPt     String
  altEn     String?
  status    ContentStatus @default(DRAFT)
  updatedAt DateTime      @updatedAt
}

model Release {
  id            String        @id @default(cuid())
  title         String
  yearLabel     String
  type          ReleaseType   @default(SINGLE)
  coverId       String?
  cover         Media?        @relation("ReleaseCover", fields: [coverId], references: [id], onDelete: Restrict)
  spotifyUrl    String?
  appleMusicUrl String?
  youtubeUrl    String?
  soundcloudUrl String?
  sortOrder     Int           @default(0)
  status        ContentStatus @default(DRAFT)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, sortOrder])
}

model Show {
  id            String        @id @default(cuid())
  title         String?
  date          DateTime      @db.Date
  time          String?
  city          String
  state         String?
  country       String?
  venue         String
  address       String?
  ticketUrl     String?
  soldOut       Boolean       @default(false)
  featured      Boolean       @default(false)
  showStatus    ShowStatus    @default(SCHEDULED)
  imageId       String?
  image         Media?        @relation("ShowImage", fields: [imageId], references: [id], onDelete: Restrict)
  internalNotes String?       @db.Text
  status        ContentStatus @default(DRAFT)
  sortOrder     Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, date])
}

model GalleryItem {
  id          String        @id @default(cuid())
  mediaId     String
  media       Media         @relation("GalleryMedia", fields: [mediaId], references: [id], onDelete: Restrict)
  altPt       String
  altEn       String?
  captionPt   String?
  captionEn   String?
  orientation Orientation   @default(LANDSCAPE)
  sortOrder   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

model PressItem {
  id          String        @id @default(cuid())
  outlet      String
  /// Headline as published by the outlet (not translated).
  title       String
  dateLabel   String
  publishedAt DateTime?     @db.Date
  url         String?
  excerptPt   String?       @db.Text
  excerptEn   String?       @db.Text
  logoId      String?
  logo        Media?        @relation("PressLogo", fields: [logoId], references: [id], onDelete: Restrict)
  sortOrder   Int           @default(0)
  status      ContentStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, sortOrder])
}

// ---------------------------------------------------------------------------
// Operational models
// ---------------------------------------------------------------------------

model BookingRequest {
  id        String               @id @default(cuid())
  name      String
  company   String?
  whatsapp  String
  email     String
  city      String
  eventType String
  eventDate DateTime?            @db.Date
  message   String?              @db.Text
  status    BookingRequestStatus @default(NEW)
  ipHash    String?
  userAgent String?
  createdAt DateTime             @default(now())

  @@index([status, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entityId  String?
  summary   String?
  diff      Json?
  createdAt DateTime @default(now())

  @@index([entity, createdAt])
}
