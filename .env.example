# Public site URL used for metadata, Open Graph, sitemap, robots.txt and
# Auth.js callback URLs.
NEXT_PUBLIC_SITE_URL=https://alansaher.com

# --- Database (Supabase Postgres via Prisma) --------------------------------
# Supabase Dashboard > Project Settings > Database > Connection string.
# DATABASE_URL: the POOLED connection (Supavisor/PgBouncer, port 6543) —
#   used by the running app. Required flags: sslmode=require&uselibpqcompat=true&pgbouncer=true&connection_limit=1
#   (uselibpqcompat: without it node-postgres treats "require" as verify-full
#   and rejects Supabase's CA — "self-signed certificate in certificate chain").
# DIRECT_URL: the DIRECT connection (port 5432) — used only by the Prisma
#   CLI (migrate/studio), never by the deployed app.
DATABASE_URL="postgresql://postgres:[PASSWORD]@[PROJECT-REF].pooler.supabase.com:6543/postgres?sslmode=require&uselibpqcompat=true&pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --- Storage (Supabase Storage) ---------------------------------------------
# Supabase Dashboard > Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[anon public key]"
# Server-only — never expose with a NEXT_PUBLIC_ prefix. Used to sign
# uploads/deletes from admin Server Actions/Route Handlers only.
SUPABASE_SERVICE_ROLE_KEY="[service_role secret key]"

# --- Auth (Auth.js v5) -------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="[random secret]"
AUTH_TRUST_HOST="true"

# --- Initial admin user (used only by `npm run db:seed`) --------------------
# ADMIN_INITIAL_PASSWORD is optional — omit it and the seed script generates
# and prints a random password once. Change it after first login either way.
ADMIN_EMAIL="alan@example.com"
# ADMIN_INITIAL_PASSWORD="choose-a-strong-password"

# --- Misc ---------------------------------------------------------------
# Shared secret for POST /api/revalidate (manual "republish site" trigger).
REVALIDATE_SECRET="[random secret]"

# Set once a real booking-notification email provider is connected (see
# src/app/api/booking/route.ts). Never commit the real value.
# BOOKING_NOTIFY_EMAIL=booking@alansaher.com
